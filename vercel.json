{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "client": {
        "root": "client",
        "framework": "vite",
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      },
      "server": {
        "root": "server",
        "framework": "express",
        "entrypoint": "server.js",
        "bindings": [
          {
            "type": "service",
            "service": "client",
            "format": "url",
            "env": "CLIENT_SERVICE_URL"
          }
        ]
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "server"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "client"
        }
      }
    ]
  }